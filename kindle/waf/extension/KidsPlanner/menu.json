          "params": "/mnt/us/extensions/KidsPlanner/install.sh install",
          "exitmenu": false,
          "refresh": true,
          "status": true,
          "internal": "status Refreshing Kids Planner WAF"
        },
        {
          "name": "Launch Kids Planner",
          "action": "/bin/sh",
          "params": "/mnt/us/extensions/KidsPlanner/install.sh launch",
